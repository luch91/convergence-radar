# Use fixture data until live ingestion has an approved wallet registry and mapped provider response.
DATA_SOURCE=fixture
INGESTION_INTERVAL_MS=300000
API_PORT=3000
DATABASE_URL=
REDIS_URL=
PAYMENT_MODE=disabled
PAY_TO_ADDRESS=

# Required only for pnpm --filter @convergence-radar/api test:x402.
