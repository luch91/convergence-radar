CONFIRM_LIVE_PAYMENT=no

# Server-side API address for the web application.
API_BASE_URL=https://convergence-radar.onrender.com

# Required only when DATA_SOURCE=live.
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=
OKX_ONCHAINOS_BASE_URL=https://web3.okx.com
