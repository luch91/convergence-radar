    "@okxweb3/x402-fetch": "^0.1.0",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "pg": "8.16.3",
    "redis": "4.7.1",
    "viem": "^2.55.13"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.12",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.6",
    "vitest": "^3.2.4"
  }
}
